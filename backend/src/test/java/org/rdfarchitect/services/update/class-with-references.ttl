ex:derivedClass.associatedClass
    rdf:type                  rdf:Property ;
    rdfs:label                "associatedClass"@en ;
    rdfs:domain               ex:derivedClass ;
    rdfs:range                ex:associatedClass ;
    cims:AssociationUsed      "Yes" ;
    cims:inverseRoleName      ex:associatedClass.derivedClass ;
    cims:multiplicity         cims:M:0..n ;
    <http://example.org#uuid> "4d8e1f66-5a6b-4c83-9d94-0e5f6a7b8c25" .

ex:associatedClass.derivedClass
    rdf:type                  rdf:Property ;
    rdfs:label                "derivedClass"@en ;
    rdfs:domain               ex:associatedClass ;
    rdfs:range                ex:derivedClass ;
    cims:AssociationUsed      "Yes" ;
    cims:inverseRoleName      ex:derivedClass.associatedClass ;
    cims:multiplicity         cims:M:0..n ;
    <http://example.org#uuid> "5e9f2a77-6b7c-4d94-8ea5-1f6a7b8c9d36" .

ex:otherClass
    rdf:type                  rdfs:Class ;
    rdfs:label                "otherClass"@en ;
    <http://example.org#uuid> "1a9b8c77-2d3e-4f50-8a61-7b2c3d4e5f92" .

