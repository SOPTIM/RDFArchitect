PREFIX cims:   <http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX uml:    <http://iec.ch/TC57/NonStandard/UML#>
PREFIX ex:     <http://example.org#>

ex:class
    rdf:type                  rdfs:Class ;
    rdfs:label                "oldLabel"@en ;
    rdfs:subClassOf           ex:BaseClass ;
    cims:stereotype           uml:concrete ;
    <http://example.org#uuid> "43836908-c7f7-4749-bb8b-3ac9250de655" .

ex:BaseClass
    rdf:type                  rdfs:Class ;
    rdfs:label                "BaseClass"@en ;
    rdfs:subClassOf           ex:RootClass ;
    <http://example.org#uuid> "8c1b2a77-4f6d-4e18-95c7-2a3b4c5d6e70" .

ex:RootClass
    rdf:type                  rdfs:Class ;
    rdfs:label                "RootClass"@en ;
    <http://example.org#uuid> "0a1b2c3d-4e5f-4a60-8b71-9c8d7e6f5a40" .

ex:BaseClass.attribute
    rdf:type                  rdf:Property ;
    rdfs:label                "attribute"@en ;
    rdfs:domain               ex:BaseClass ;
    cims:dataType             xsd:string ;
    cims:multiplicity         cims:M:1..1 ;
    cims:stereotype           uml:attribute ;
    <http://example.org#uuid> "9d2c3b88-3e5c-4f29-86b8-1b2c3d4e5f81" .

ex:class.attribute
    rdf:type                  rdf:Property ;
    rdfs:label                "attribute"@en ;
    rdfs:domain               ex:class ;
    cims:dataType             ex:MyDataType ;
    cims:multiplicity         cims:M:1..1 ;
    cims:stereotype           uml:attribute ;
    <http://example.org#uuid> "1b8f1a2c-7d3e-4f4a-9c21-0d5a6e7b8c90" .

ex:class.otherAttribute
    rdf:type                  rdf:Property ;
    rdfs:label                "otherAttribute"@en ;
    rdfs:domain               ex:class ;
    cims:dataType             ex:OtherDataType ;
    cims:multiplicity         cims:M:1..1 ;
    cims:stereotype           uml:attribute ;
    <http://example.org#uuid> "6a0b3c88-7c8d-4ea5-9fb6-2a7b8c9d0e47" .

ex:OtherDataType
    rdf:type                  rdfs:Class ;
    rdfs:label                "OtherDataType"@en ;
    cims:stereotype           "CIMDatatype" ;
    <http://example.org#uuid> "7b1c4d99-8d9e-4fb6-a0c7-3b8c9d0e1f58" .

ex:MyDataType
    rdf:type                  rdfs:Class ;
    rdfs:label                "MyDataType"@en ;
    rdfs:comment              "A data type." ;
    cims:stereotype           "CIMDatatype" ;
    <http://example.org#uuid> "2c9e0d11-5b47-4ad2-8f3a-6e1c9b2d7f45" .

ex:class.valueAttribute
    rdf:type                  rdf:Property ;
    rdfs:label                "valueAttribute"@en ;
    rdfs:domain               ex:class ;
    cims:dataType             ex:ValueType ;
    cims:multiplicity         cims:M:1..1 ;
    cims:stereotype           uml:attribute ;
    <http://example.org#uuid> "9d3e6f11-0f1a-4b28-c2e9-5d0e1f2a3b7a" .

ex:ValueType
    rdf:type                  rdfs:Class ;
    rdfs:label                "ValueType"@en ;
    cims:stereotype           "CIMDatatype" ;
    <http://example.org#uuid> "8c2d5e00-9e0f-4a17-b1d8-4c9d0e1f2a69" .

ex:ValueType.unit
    rdf:type                  rdf:Property ;
    rdfs:label                "unit"@en ;
    rdfs:domain               ex:ValueType ;
    cims:dataType             ex:DeepType ;
    cims:multiplicity         cims:M:1..1 ;
    cims:stereotype           uml:attribute ;
    <http://example.org#uuid> "0e4f7a22-1a2b-4c39-d3f0-6e1f2a3b4c8b" .

ex:DeepType
    rdf:type                  rdfs:Class ;
    rdfs:label                "DeepType"@en ;
    cims:stereotype           "Primitive" ;
    <http://example.org#uuid> "1f5a8b33-2b3c-4d40-e4a1-7f2a3b4c5d9c" .

ex:MyDataType.value
    rdf:type                  rdf:Property ;
    rdfs:label                "value"@en ;
    rdfs:domain               ex:MyDataType ;
    cims:dataType             ex:ValueType ;
    cims:multiplicity         cims:M:1..1 ;
    cims:stereotype           uml:attribute ;
    <http://example.org#uuid> "3d7c4b22-9a58-4c63-b0e1-7f2d8a3e4c56" .

ex:associatedClass
    rdf:type                  rdfs:Class ;
