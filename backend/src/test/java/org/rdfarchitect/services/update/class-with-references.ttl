ex:associatedClass.attribute
    rdf:type                  rdf:Property ;
    rdfs:label                "attribute"@en ;
    rdfs:domain               ex:associatedClass ;
    cims:dataType             ex:ValueType ;
    cims:multiplicity         cims:M:1..1 ;
    cims:stereotype           uml:attribute ;
    <http://example.org#uuid> "5f5e6d44-7c7a-4e85-92a3-9b4d0c5e6f78" .

ex:class.associatedClass
    rdf:type                  rdf:Property ;
    rdfs:label                "associatedClass"@en ;
    rdfs:domain               ex:class ;
    rdfs:range                ex:associatedClass ;
    cims:AssociationUsed      "Yes" ;
    cims:inverseRoleName      ex:associatedClass.class ;
    cims:multiplicity         cims:M:0..n ;
    <http://example.org#uuid> "6a4f7e55-6d8b-4f96-83b4-0c5e1d6f7a89" .

ex:associatedClass.class
    rdf:type                  rdf:Property ;
    rdfs:label                "class"@en ;
    rdfs:domain               ex:associatedClass ;
    rdfs:range                ex:class ;
    cims:AssociationUsed      "Yes" ;
    cims:inverseRoleName      ex:class.associatedClass ;
    cims:multiplicity         cims:M:0..n ;
    <http://example.org#uuid> "7b3a8f66-5e9c-4a07-74c5-1d6f2e7a8b90" .

ex:derivedClass
    rdf:type                  rdfs:Class ;
    rdfs:label                "derivedClass"@en ;
